* text=auto

# Windows-only project: keep scripts and sources LF in the repo, check out as-is
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.geojson text eol=lf

# Binary assets must never be line-ending converted
*.ttf   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.svg   text eol=lf
